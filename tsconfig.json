{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": ["bun-types"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.tsx", "scripts/**/*.ts"]
}
