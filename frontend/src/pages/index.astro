---
import { App } from "../components/App";
import SEO from "../components/SEO.astro";
import Layout from "../layouts/Layout.astro";

export const prerender = false;

const title = "Nexora — Digital goods";
const description =
  "Buy software license keys, premium accounts and top-ups. Instant automated delivery. Pay in Litecoin.";
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Nexora",
  url: (Astro.site ?? new URL(Astro.url.origin)).href,
};
---

<Layout title={title} description={description}>
  <SEO slot="head" title={title} description={description} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(org)} />
  <App client:load />
</Layout>
