# Copy to .env and fill in. .env is gitignored.
PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:4321

# Single admin account.
ADMIN_EMAIL=admin@example.com
# Dev convenience (hashed on boot):
ADMIN_PASSWORD=change-me
# Production (generate an argon2id hash and use this instead of ADMIN_PASSWORD):
# ADMIN_PASSWORD_HASH=

# LTC wallet xpub can be pasted in the admin dashboard, or seeded here:
# LTC_XPUB=

# Optional email (also configurable in admin settings):
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
