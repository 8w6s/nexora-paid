# Copy to .env and fill in. .env is gitignored.
#
# Conventions:
#   # REQUIRED — backend refuses to boot (or runs unsafely) without this
#   # OPTIONAL — has a safe default, override only when needed
#   # SECRET   — never commit, never log
#
# Quickstart: only the REQUIRED entries need values to boot a fresh clone.

# === Core HTTP ===

# OPTIONAL — default 3000
PORT=3000
# OPTIONAL — default "development". Set to "production" to harden behavior.
NODE_ENV=development
# REQUIRED — frontend origin that the API trusts for CORS + cookie SameSite.
PUBLIC_ORIGIN=http://localhost:4321
# OPTIONAL — set to "true" only when behind a TLS-terminating proxy you control.
# When unset, X-Forwarded-* headers are IGNORED to prevent rate-limit spoofing.
# TRUST_PROXY=false

# === Admin account ===

# REQUIRED — single admin login email.
ADMIN_EMAIL=admin@example.com
# REQUIRED for dev, SECRET — hashed to argon2id on boot.
ADMIN_PASSWORD=change-me
# RECOMMENDED for prod, SECRET — argon2id hash; supersedes ADMIN_PASSWORD if set.
# ADMIN_PASSWORD_HASH=
# OPTIONAL — set to "true" to force re-bootstrap of admin on next boot.
# ADMIN_BOOTSTRAP_FORCE=false
# OPTIONAL — set to "true" to force admin 2FA enrollment on next boot.
# ADMIN_BOOTSTRAP_FORCE_2FA=false

# === Secrets (SECRET — never commit, generate fresh per environment) ===

# REQUIRED for production, SECRET — 32+ byte random key for encrypting LTC xpub
# and other sensitive columns at rest. Generate: openssl rand -hex 32
# DATABASE_ENCRYPTION_KEY=

# REQUIRED for production, SECRET — HMAC secret for signed order tokens (used
# by the storefront poling endpoint). Generate: openssl rand -hex 32
# ORDER_TOKEN_SECRET=

# OPTIONAL, SECRET — license signing secret for offline license issuance.
# NEXORA_LICENSE_SECRET=

# OPTIONAL, SECRET — pre-shared key for the in-place updater endpoint.
# NEXORA_UPDATER_PSK=

# === Database & file storage ===

# OPTIONAL — default "./data/app.db". Path to the SQLite DB file.
# DB_PATH=./data/app.db
# OPTIONAL — default "./data". Root dir for runtime files (DB, exports, etc.)
# NEXORA_DATA_ROOT=./data
# OPTIONAL — license file path (overides default ./data/license.bin)
# LICENSE_FILE=

# === LTC wallet ===

# OPTIONAL — can be pasted in the admin dashboard instead.
# LTC_XPUB=
# OPTIONAL — default "false". When "true", accept Ltub/Mtub variants in xpub
# validation. Only enable if you understand the cross-chain implications.
# NEXORA_ALLOW_CROSS_CHAIN_XPUB=false
# OPTIONAL — default 50. Max orders the watcher checks per tick.
# WATCHER_TICK_QUOTA=50

# === Image hosting (catbox.moe) ===

# OPTIONAL, SECRET — userhash for catbox.moe uploads (album persistence).
# CATBOX_USERHASH=

# === Email delivery (also configurable in admin settings UI) ===

# OPTIONAL — "resend" or "smtp"
# EMAIL_PROVIDER=resend
# OPTIONAL, SECRET — Resend API key
# RESEND_API_KEY=
# OPTIONAL — SMTP settings
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# === Integrity / build provenance ===

# OPTIONAL — "true" in production. When set, refuse to boot if the integrity
# manifest signature does not verify against NEXORA_MANIFEST_PUBKEY_HEX.
# NEXORA_REQUIRE_SIGNED=false
# OPTIONAL — alt path to the build manifest (default: ./manifest.json)
# NEXORA_MANIFEST_FILE=
# OPTIONAL — hex-encoded ed25519 public key for manifest signature verification.
# NEXORA_MANIFEST_PUBKEY_HEX=
# OPTIONAL — set to "true" ONLY in dev to skip integrity checks at boot.
# NEXORA_DEV_SKIP_INTEGRITY=false

# === Updater / release channel ===

# OPTIONAL — "stable" | "beta" | "edge" (default: stable)
# NEXORA_UPDATE_CHANNEL=stable
# OPTIONAL, SECRET — GHCR token for pulling private container images.
# NEXORA_GHCR_TOKEN=
# OPTIONAL, SECRET — alternative GHCR token env name (legacy).
# GHCR_TOKEN=
# OPTIONAL — alternate file-server URL for offline air-gapped installs.
# NEXORA_FILESERVER_URL=

# === Observability / dev knobs ===

# OPTIONAL — "trace" | "debug" | "info" | "warn" | "error" (default: info)
# LOG_LEVEL=info
# OPTIONAL — set "true" for verbose boot logs.
# NEXORA_DEBUG_BOOT=false
# OPTIONAL, SECRET — bearer token guarding /dev/logs in non-prod.
# DEV_LOGS_TOKEN=
# OPTIONAL — FontAwesome kit URL for admin UI icon set
# FA_KIT_URL=

# === Safety overrides — DO NOT enable in production ===

# DANGER — "true" enables raw-SQL endpoints meant only for migrations.
# NEXORA_ENABLE_RAW_SQL=false