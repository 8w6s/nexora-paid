# License signing keys + issued licenses — maintainer-only artifacts.
# If the private key leaks, anyone can forge Paid licenses for free.
.keys/
issued/
*.license

# Signed integrity manifest — built per-customer per-release by
# scripts/build-manifest.ts, shipped alongside the Paid tarball. Never
# committed: each customer build has a unique signature, and committing
# one would leak the build_id + customer_id watermark of whichever
# customer's manifest happened to be at the dev machine.
/manifest.signed.json
/manifest.*.signed.json

.dev-logs/

